# Copy this file to .env.local for local development, and add the same
# variables in Vercel (Project > Settings > Environment Variables) for production.

# Resend (https://resend.com) sends contact-form enquiries to your inbox.
RESEND_API_KEY=

# Where enquiries are delivered.
CONTACT_TO_EMAIL=hello@elementvertex.com

# Sender address. Must be on a domain you have verified in Resend,
# e.g. "Element Vertex <hello@elementvertex.com>". Until then, Resend's
# test sender only delivers to the email address on your Resend account.
CONTACT_FROM_EMAIL=Element Vertex <onboarding@resend.dev>
